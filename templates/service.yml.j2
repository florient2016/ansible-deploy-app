---
apiVersion: v1
kind: Service
metadata:
  name: {{ app_name }}-svc
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
spec:
  type: NodePort
  selector:
    app: {{ app_name }}
  ports:
    - name: http
      protocol: TCP
      port: {{ app_port }}
      targetPort: {{ app_port }}
      nodePort: {{ app_node_port }}
